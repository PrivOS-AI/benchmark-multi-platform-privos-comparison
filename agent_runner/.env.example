# Live agent benchmark (agent_runner/). Copy to agent_runner/.env (git-ignored) or point BM_ENV at another file.
# Use dedicated TEST workspaces only — the runner creates, edits and deletes data there.

# Model: any OpenAI-compatible endpoint. The runner asserts the returned model on every call.
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_MODEL=glm-5.3
ZAI_API_KEY=

# Stack A chat: Telegram bot that is a member of the test group (post the seed messages as an anonymous admin)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Stack C chat: Slack bot token (channels:history, chat:write) + test channel
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
SLACK_CHANNEL_ID=
# optional: app id whose bot messages reset() must keep (e.g. another integration in the channel)
SLACK_IGNORE_APP_ID=

# Tasks: Notion internal integration shared with the test Tasks database
NOTION_TOKEN=
NOTION_DATABASE_ID=

# CRM: HubSpot private-app token (crm.objects.contacts/deals read+write)
HUBSPOT_TOKEN=

# PrivOS: hub URL, bot key and the test room with its Tasks / CRM lists
PRIVOS_URL=
PRIVOS_TOKEN=
PRIVOS_ROOM_ID=
PRIVOS_LIST_ID=
PRIVOS_CRM_LIST_ID=
# checkout of the PrivOS agent skills (privos-chat, privos-list scripts) for the privos_skill stack
PRIVOS_SANDBOX_DIR=

# optional, report.py only: USD per 1M tokens to print dollars
# PRICE_INPUT= PRICE_CACHED= PRICE_OUTPUT=
