# Live-capture credentials (read-only). Copy to .env and fill only the platforms
# you want to capture. Missing platforms are skipped, never fail the run.
# Load with: set -a; source .env; set +a   (then run src/live_capture.py)

# Telegram Bot API
TELEGRAM_BOT_TOKEN=

# Notion (internal integration token + a database to read the schema of)
NOTION_TOKEN=
NOTION_DATABASE_ID=

# HubSpot private-app token (scope: crm.objects.contacts.read)
HUBSPOT_TOKEN=

# Discord bot token + a channel the bot can read
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Trello API key + token + a list to read cards from
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=

# PrivOS hub REST (bot token + a room to read messages from)
PRIVOS_URL=
PRIVOS_TOKEN=
PRIVOS_ROOM_ID=
